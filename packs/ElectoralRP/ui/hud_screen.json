{
  "namespace": "hud",

  // The ElectoralV2 map screen. The scripts send the map as action bar text that
  // starts with an invisible tag; each glyph in it is one coloured pixel from
  // font/glyph_E1..F0. With the tag present the action bar becomes a big map in the
  // middle of the screen; without it the action bar looks and fades like normal.
  // (The tag also matches Explorer's World Map, so either pack's HUD can draw it.)

  "electoral_map_hold": {
    "anim_type": "wait",
    "duration": 300,
    "end_event": "hud_actionbar_text_complete",
    "destroy_at_end": "hud_actionbar_text"
  },

  "hud_actionbar_text": {
    "type": "image",
    "$atext": "$actionbar_text",
    "$is_map": "(not (($atext - '§W§O§R§L§D§M') = $atext))",
    "$is_electoral": "(not (($atext - '§E§L§V') = $atext))",
    "$box_size|default": [ "100%c + 12px", "100%c + 5px" ],
    "$box_offset|default": [ 0, "50%-68px" ],
    "$box_texture|default": "textures/ui/hud_tip_text_background",
    "$box_alpha|default": "@hud.anim_actionbar_text_background_alpha_out",
    "variables": [
      {
        "requires": "$is_map",
        "$box_size": [ "52%c + 12px", "100%c + 15px" ],
        "$box_offset": [ 0, -6 ],
        "$box_texture": "textures/ui/greyBorder",
        "$box_alpha": 1.0
      }
    ],
    "size": "$box_size",
    "offset": "$box_offset",
    "texture": "$box_texture",
    "alpha": "$box_alpha",
    "controls": [
      {
        "actionbar_message": {
          "type": "label",
          "$msg_font|default": "normal",
          "$msg_scale|default": 1.0,
          "$msg_offset|default": [ 0, 0 ],
          "$msg_padding|default": 0,
          "$msg_alpha|default": "@hud.anim_actionbar_text_alpha_out",
          "$msg_controls|default": [],
          "$msg_shadow|default": true,
          "$msg_filter|default": true,
          "variables": [
            {
              "requires": "$is_map",
              "$msg_font": "small",
              "$msg_scale": 0.15,
              "$msg_offset": [ 0, -15 ],
              "$msg_padding": 6,
              "$msg_alpha": "@hud.electoral_map_hold",
              "$msg_controls": [ { "@hud.electoral_map_fill": {} }, { "@hud.electoral_map_hints": {} } ],
              "$msg_shadow": false,
              "$msg_filter": false
            }
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "color": "$tool_tip_text",
          "font_size": "$msg_font",
          "font_scale_factor": "$msg_scale",
          "line_padding": "$msg_padding",
          "offset": "$msg_offset",
          "layer": 31,
          "text": "$actionbar_text",
          "localize": false,
          "shadow": "$msg_shadow",
          "enable_profanity_filter": "$msg_filter",
          "alpha": "$msg_alpha",
          "controls": "$msg_controls"
        }
      }
    ]
  },

  // Control hints under the map (only for ElectoralV2's map).
  "electoral_map_hints": {
    "type": "label",
    "visible": "$is_electoral",
    "anchor_from": "bottom_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 4 ],
    "color": [ 1.0, 1.0, 1.0 ],
    "shadow": true,
    "font_size": "normal",
    "font_scale_factor": 1.0,
    "layer": 32,
    "localize": false,
    "text": "Move cursor: §eWASD / stick§r   Use tool: §eJump§r   Menu: §eSneak§r   Zoom: §escroll hotbar",
    "alpha": "@hud.electoral_map_hold"
  },

  // The same picture drawn again a hair to the side: closes the hairline gaps
  // between glyphs so the map looks solid.
  "electoral_map_fill": {
    "type": "label",
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": [ -0.3, 0 ],
    "color": "$tool_tip_text",
    "font_size": "small",
    "font_scale_factor": 0.15,
    "line_padding": 6,
    "layer": 30,
    "text": "$actionbar_text",
    "localize": false,
    "alpha": "@hud.electoral_map_hold"
  }
}
